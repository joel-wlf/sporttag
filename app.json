{
  "expo": {
    "name": "Sporttag",
    "slug": "sporttag",
    "version": "1.0.0",
    "icon": "./assets/branding/app-icon/app-icon.png",
    "orientation": "portrait",
    "scheme": "sporttag",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "@maplibre/maplibre-react-native",
      "expo-sqlite",
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.sporttag",
      "icon": "./assets/branding/app-icon/ios/Sporttag.icon",
      "infoPlist": {
        "NSSupportsLiveActivities": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.example.sporttag",
      "icon": "./assets/branding/app-icon/app-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/app-icon/android/foreground.png",
        "monochromeImage": "./assets/branding/app-icon/android/monochrome.png",
        "backgroundColor": "#556B2F"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/branding/app-icon/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.example.sporttag.widget",
                  "targetName": "SporttagWidgets",
                  "entitlements": {}
                }
              ]
            }
          }
        },
        "projectId": "149a1864-56e3-4770-a98a-62f0a38b66d1"
      }
    },
    "owner": "joel377wol"
  }
}
